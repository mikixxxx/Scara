;;CONTROL = rho4
;;INT = CIRCULAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCCIRC

EXTERNAL PERMPROG: CIRC_MID_X
EXTERNAL PERMPROG: CIRC_MID_Y
EXTERNAL PERMPROG: CIRC_MID_Z
EXTERNAL PERMPROG: CIRC_MID_R

EXTERNAL PERMPROG: CIRC_END_X
EXTERNAL PERMPROG: CIRC_END_Y
EXTERNAL PERMPROG: CIRC_END_Z
EXTERNAL PERMPROG: CIRC_END_R

EXTERNAL PERMPROG: CIRC_SPEED
EXTERNAL PERMPROG: MOVE_STATE

POINT: MIDPOINT
POINT: ENDPOINT

BEGIN

MIDPOINT.K1=CIRC_MID_X
MIDPOINT.K2=CIRC_MID_Y
MIDPOINT.K3=CIRC_MID_Z
MIDPOINT.K4=CIRC_MID_R

ENDPOINT.K1=CIRC_END_X
ENDPOINT.K2=CIRC_END_Y
ENDPOINT.K3=CIRC_END_Z
ENDPOINT.K4=CIRC_END_R

MOVE CIRCULAR WITH V=CIRC_SPEED TO (MIDPOINT,ENDPOINT)

MOVE_STATE=2

PROGRAM_END