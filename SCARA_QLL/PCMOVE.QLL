;;CONTROL = rho4
;;INT = PTP
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCMOVE

EXTERNAL PERMPROG: TARGET_X
EXTERNAL PERMPROG: TARGET_Y
EXTERNAL PERMPROG: TARGET_Z
EXTERNAL PERMPROG: TARGET_R
EXTERNAL PERMPROG: MOVE_STATE
EXTERNAL PERMPROG: MOVE_SPEED

POINT: TARGET

BEGIN

TARGET.K1=TARGET_X
TARGET.K2=TARGET_Y
TARGET.K3=TARGET_Z
TARGET.K4=TARGET_R

V_PTP=MOVE_SPEED
AFACTOR=5%
DFACTOR=5%

MOVE PTP TO TARGET
MOVE_STATE=2

PROGRAM_END