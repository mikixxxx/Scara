;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCRING

EXTERNAL PERMPROG: MOVE_STATE
EXTERNAL PERMPROG: MOVE_ERROR

EXTERNAL PERMPROG: SA_FREE
EXTERNAL PERMPROG: SB_FREE
EXTERNAL PERMPROG: SA_SEQ
EXTERNAL PERMPROG: SB_SEQ
EXTERNAL PERMPROG: SA_LAST
EXTERNAL PERMPROG: SB_LAST
EXTERNAL PERMPROG: STR_EXPECT
EXTERNAL PERMPROG: STR_UNDER

EXTERNAL: PCBUFA
EXTERNAL: PCBUFB
EXTERNAL: PCENDA
EXTERNAL: PCENDB

BEGIN

PROGR_SLOPE

STR_EXPECT=0
STR_UNDER=0

RING_A:

IF SA_FREE<>0 THEN JUMP UNDER
IF SA_SEQ<>STR_EXPECT THEN JUMP UNDER

IF SA_LAST=1 THEN JUMP A_FINAL

PCBUFA
SA_FREE=1
STR_EXPECT=STR_EXPECT+1
JUMP RING_B


A_FINAL:

PCENDA
SA_FREE=1
STR_EXPECT=STR_EXPECT+1
JUMP DONE


RING_B:

IF SB_FREE<>0 THEN JUMP UNDER
IF SB_SEQ<>STR_EXPECT THEN JUMP UNDER

IF SB_LAST=1 THEN JUMP B_FINAL

PCBUFB
SB_FREE=1
STR_EXPECT=STR_EXPECT+1
JUMP RING_A


B_FINAL:

PCENDB
SB_FREE=1
STR_EXPECT=STR_EXPECT+1
JUMP DONE


UNDER:

STR_UNDER=1
MOVE_STATE=3
MOVE_ERROR=29001
BLOCK_SLOPE
HALT


DONE:

BLOCK_SLOPE
MOVE_STATE=2
MOVE_ERROR=0
HALT


PROGRAM_END
