;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCLINEAR

EXTERNAL PERMPROG: TARGET_X
EXTERNAL PERMPROG: TARGET_Y
EXTERNAL PERMPROG: TARGET_Z
EXTERNAL PERMPROG: TARGET_R
EXTERNAL PERMPROG: LINEAR_SPEED
EXTERNAL PERMPROG: MOVE_STATE

POINT: TARGET

BEGIN

TARGET.K1=TARGET_X
TARGET.K2=TARGET_Y
TARGET.K3=TARGET_Z
TARGET.K4=TARGET_R

MOVE LINEAR WITH V=LINEAR_SPEED TO TARGET

MOVE_STATE=2

PROGRAM_END