;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM HYRING

EXTERNAL PERMPROG: MOVE_STATE
EXTERNAL PERMPROG: MOVE_ERROR

EXTERNAL PERMPROG: HA_FREE
EXTERNAL PERMPROG: HB_FREE
EXTERNAL PERMPROG: HA_SEQ
EXTERNAL PERMPROG: HB_SEQ
EXTERNAL PERMPROG: HA_LAST
EXTERNAL PERMPROG: HB_LAST
EXTERNAL PERMPROG: HY_EXPECT
EXTERNAL PERMPROG: HY_UNDER

EXTERNAL: HYBUFA
EXTERNAL: HYBUFB
EXTERNAL: HYENDA
EXTERNAL: HYENDB

BEGIN

PROGR_SLOPE

HY_EXPECT=0
HY_UNDER=0

RING_A:

IF HA_FREE<>0 THEN JUMP UNDER
IF HA_SEQ<>HY_EXPECT THEN JUMP UNDER

IF HA_LAST=1 THEN JUMP A_FINAL

HYBUFA
HA_FREE=1
HY_EXPECT=HY_EXPECT+1
JUMP RING_B


A_FINAL:

HYENDA
HA_FREE=1
HY_EXPECT=HY_EXPECT+1
JUMP DONE


RING_B:

IF HB_FREE<>0 THEN JUMP UNDER
IF HB_SEQ<>HY_EXPECT THEN JUMP UNDER

IF HB_LAST=1 THEN JUMP B_FINAL

HYBUFB
HB_FREE=1
HY_EXPECT=HY_EXPECT+1
JUMP RING_A


B_FINAL:

HYENDB
HB_FREE=1
HY_EXPECT=HY_EXPECT+1
JUMP DONE


UNDER:

HY_UNDER=1
MOVE_STATE=3
MOVE_ERROR=29002
BLOCK_SLOPE
HALT


DONE:

BLOCK_SLOPE
MOVE_STATE=2
MOVE_ERROR=0
HALT


PROGRAM_END
