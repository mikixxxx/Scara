PCBUFA
SA_FREE=1

PCBUFB
SB_FREE=1

PCBUFA
SA_FREE=1

PCENDB
SB_FREE=1

BLOCK_SLOPE

MOVE_STATE=2
MOVE_ERROR=0
HALT

S7:

PROGR_SLOPE

PCBUFA
