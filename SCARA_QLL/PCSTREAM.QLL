;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCSTREAM

EXTERNAL PERMPROG: MOVE_STATE
EXTERNAL PERMPROG: MOVE_ERROR
EXTERNAL PERMPROG: STR_BLOCKS
EXTERNAL PERMPROG: SA_FREE
EXTERNAL PERMPROG: SB_FREE

EXTERNAL: PCBUFA
EXTERNAL: PCBUFB
EXTERNAL: PCENDA
EXTERNAL: PCENDB

BEGIN

; PCSTREAM V2 / long chain
; Static branch selection happens before the first MOVE.
; Maximum = 32 controller buffers = 512 points.
IF STR_BLOCKS=1 THEN JUMP S1
IF STR_BLOCKS=2 THEN JUMP S2
IF STR_BLOCKS=3 THEN JUMP S3
IF STR_BLOCKS=4 THEN JUMP S4
IF STR_BLOCKS=5 THEN JUMP S5
IF STR_BLOCKS=6 THEN JUMP S6
IF STR_BLOCKS=7 THEN JUMP S7
IF STR_BLOCKS=8 THEN JUMP S8
IF STR_BLOCKS=9 THEN JUMP S9
IF STR_BLOCKS=10 THEN JUMP S10
IF STR_BLOCKS=11 THEN JUMP S11
IF STR_BLOCKS=12 THEN JUMP S12
IF STR_BLOCKS=13 THEN JUMP S13
IF STR_BLOCKS=14 THEN JUMP S14
IF STR_BLOCKS=15 THEN JUMP S15
IF STR_BLOCKS=16 THEN JUMP S16
IF STR_BLOCKS=17 THEN JUMP S17
IF STR_BLOCKS=18 THEN JUMP S18
IF STR_BLOCKS=19 THEN JUMP S19
IF STR_BLOCKS=20 THEN JUMP S20
IF STR_BLOCKS=21 THEN JUMP S21
IF STR_BLOCKS=22 THEN JUMP S22
IF STR_BLOCKS=23 THEN JUMP S23
IF STR_BLOCKS=24 THEN JUMP S24
IF STR_BLOCKS=25 THEN JUMP S25
IF STR_BLOCKS=26 THEN JUMP S26
IF STR_BLOCKS=27 THEN JUMP S27
IF STR_BLOCKS=28 THEN JUMP S28
IF STR_BLOCKS=29 THEN JUMP S29
IF STR_BLOCKS=30 THEN JUMP S30
IF STR_BLOCKS=31 THEN JUMP S31
IF STR_BLOCKS=32 THEN JUMP S32

MOVE_STATE=3
MOVE_ERROR=2
HALT


S1:

PROGR_SLOPE

PCENDA
SA_FREE=1

BLOCK_SLOPE

MOVE_STATE=2
MOVE_ERROR=0
HALT

