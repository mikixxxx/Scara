;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCHYB

EXTERNAL PERMPROG: MOVE_STATE

POINT: STARTPOS
POINT: P1
POINT: M1
POINT: P2
POINT: P3
POINT: M2
POINT: P4
POINT: P5
POINT: M3
POINT: P6
POINT: P7
POINT: M4
POINT: P8

INTEGER: T1
INTEGER: T2
INTEGER: T3
INTEGER: T4
INTEGER: T5
INTEGER: T6
INTEGER: T7
INTEGER: T8

BEGIN

; ============================================================
; V9 HYBRID DISPATCH TEST
;
; Geometry is intentionally identical to PCSMOOTH:
; rounded rectangle, width 20 mm, height 12 mm, radius 3 mm,
; V = 5 mm/s, final point exactly STARTPOS.
;
; Difference:
; Each primitive is dispatched at runtime through IF/ELSE:
;   type 1 = LINEAR
;   type 2 = CIRCULAR
;
; Bosch manual states that IF can interrupt a coherent PROGR_SLOPE
; sequence. Current PCRING has already shown IF/JUMP at buffer
; boundaries can look smooth on this controller. This program tests
; the stricter per-primitive case directly.
; ============================================================

STARTPOS=POS

P1=STARTPOS
P1.K1=P1.K1+14.0

M1=STARTPOS
M1.K1=M1.K1+16.12132034
M1.K2=M1.K2+0.87867966

P2=STARTPOS
P2.K1=P2.K1+17.0
P2.K2=P2.K2+3.0

P3=STARTPOS
P3.K1=P3.K1+17.0
P3.K2=P3.K2+9.0

M2=STARTPOS
M2.K1=M2.K1+16.12132034
M2.K2=M2.K2+11.12132034

P4=STARTPOS
P4.K1=P4.K1+14.0
P4.K2=P4.K2+12.0

P5=STARTPOS
P5.K2=P5.K2+12.0

M3=STARTPOS
M3.K1=M3.K1-2.12132034
M3.K2=M3.K2+11.12132034

P6=STARTPOS
P6.K1=P6.K1-3.0
P6.K2=P6.K2+9.0

P7=STARTPOS
P7.K1=P7.K1-3.0
P7.K2=P7.K2+3.0

M4=STARTPOS
M4.K1=M4.K1-2.12132034
M4.K2=M4.K2+0.87867966

P8=STARTPOS

; Runtime primitive types.
T1=1
T2=2
T3=1
T4=2
T5=1
T6=2
T7=1
T8=2

PROGR_SLOPE

IF T1=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P1
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M1,P1)
END

IF T2=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P2
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M1,P2)
END

IF T3=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P3
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M2,P3)
END

IF T4=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P4
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M2,P4)
END

IF T5=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P5
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M3,P5)
END

IF T6=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P6
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M3,P6)
END

IF T7=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 VIA P7
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 VIA (M4,P7)
END

IF T8=1 THEN
BEGIN
    MOVE LINEAR WITH V=5.0 TO P8
END
ELSE
BEGIN
    MOVE CIRCULAR WITH V=5.0 TO (M4,P8)
END

BLOCK_SLOPE

MOVE_STATE=2

PROGRAM_END
