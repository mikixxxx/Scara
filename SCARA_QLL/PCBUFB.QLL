;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCBUFB

EXTERNAL PERMPROG: SB_DATA
EXTERNAL PERMPROG: SB_SPEED

BEGIN

; Keep the external-routine transition in program-slope mode.
; No READ/WRITE/WAIT/IF and no point-copy assignments occur here.
PROGR_SLOPE

MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[1]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[2]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[3]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[4]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[5]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[6]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[7]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[8]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[9]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[10]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[11]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[12]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[13]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[14]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[15]
MOVE LINEAR WITH V=SB_SPEED VIA SB_DATA[16]

HALT

PROGRAM_END
