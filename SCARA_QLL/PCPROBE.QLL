;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCPROBE

EXTERNAL PERMPROG: PROBE_TGT_X
EXTERNAL PERMPROG: PROBE_TGT_Y
EXTERNAL PERMPROG: PROBE_TGT_Z
EXTERNAL PERMPROG: PROBE_TGT_R
EXTERNAL PERMPROG: PROBE_SPEED

EXTERNAL PERMPROG: PROBE_RESULT
EXTERNAL PERMPROG: PROBE_MEAS_X
EXTERNAL PERMPROG: PROBE_MEAS_Y
EXTERNAL PERMPROG: PROBE_MEAS_Z
EXTERNAL PERMPROG: PROBE_MEAS_R

EXTERNAL PERMPROG: MOVE_STATE
EXTERNAL PERMPROG: MOVE_ERROR

INPUT BINARY:611=PROBE_FAST

POINT: TARGET
POINT: MEASVAL
JC_POINT: @MEASVAL

BEGIN

TARGET.K1=PROBE_TGT_X
TARGET.K2=PROBE_TGT_Y
TARGET.K3=PROBE_TGT_Z
TARGET.K4=PROBE_TGT_R

PROBE_RESULT=0

; rho4.0 fast measurement input.
; ERROR branch is essential: do not read stale/undefined @MPOS
; if the target is reached without a new trigger.

; Use the exact MOVE UNTIL form from the Bosch rho4 manual.
; Set path speed globally immediately before the measuring move.
V=PROBE_SPEED
MOVE LINEAR UNTIL PROBE_FAST=1
    ERROR JUMP NO_HIT
TO TARGET

@MEASVAL=@MPOS
MEASVAL=WC(@MPOS)

PROBE_MEAS_X=MEASVAL.K1
PROBE_MEAS_Y=MEASVAL.K2
PROBE_MEAS_Z=MEASVAL.K3
PROBE_MEAS_R=MEASVAL.K4

PROBE_RESULT=1
MOVE_STATE=2
MOVE_ERROR=0
JUMP FINISHED

NO_HIT:

PROBE_RESULT=2
MOVE_STATE=3
MOVE_ERROR=29010

FINISHED:

PROGRAM_END
