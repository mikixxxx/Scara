P11.K4=PATHDATA[44]

P12.K1=PATHDATA[45]
P12.K2=PATHDATA[46]
P12.K3=PATHDATA[47]
P12.K4=PATHDATA[48]

P13.K1=PATHDATA[49]
P13.K2=PATHDATA[50]
