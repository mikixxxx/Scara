P3.K4=PATHDATA[12]

P4.K1=PATHDATA[13]
P4.K2=PATHDATA[14]
P4.K3=PATHDATA[15]
P4.K4=PATHDATA[16]

P5.K1=PATHDATA[17]
P5.K2=PATHDATA[18]
P5.K3=PATHDATA[19]
P5.K4=PATHDATA[20]

P6.K1=PATHDATA[21]
