P16.K1=PATHDATA[61]
P16.K2=PATHDATA[62]
P16.K3=PATHDATA[63]
P16.K4=PATHDATA[64]


; Vetev se vybere pred PROGR_SLOPE.
IF PATH_COUNT=1 THEN JUMP Path1
IF PATH_COUNT=2 THEN JUMP Path2
IF PATH_COUNT=3 THEN JUMP Path3
IF PATH_COUNT=4 THEN JUMP Path4
IF PATH_COUNT=5 THEN JUMP Path5
IF PATH_COUNT=6 THEN JUMP Path6
IF PATH_COUNT=7 THEN JUMP Path7
IF PATH_COUNT=8 THEN JUMP Path8
IF PATH_COUNT=9 THEN JUMP Path9
IF PATH_COUNT=10 THEN JUMP Path10
IF PATH_COUNT=11 THEN JUMP Path11
IF PATH_COUNT=12 THEN JUMP Path12
IF PATH_COUNT=13 THEN JUMP Path13
IF PATH_COUNT=14 THEN JUMP Path14
IF PATH_COUNT=15 THEN JUMP Path15
IF PATH_COUNT=16 THEN JUMP Path16

JUMP PathError

Path1:

MOVE LINEAR WITH V=PATH_SPEED TO P1

MOVE_STATE=2
MOVE_ERROR=0
JUMP Exit
Path2:

PROGR_SLOPE

MOVE LINEAR WITH V=PATH_SPEED VIA P1
MOVE LINEAR WITH V=PATH_SPEED TO P2

BLOCK_SLOPE

MOVE_STATE=2
MOVE_ERROR=0
JUMP Exit
Path3:

PROGR_SLOPE

MOVE LINEAR WITH V=PATH_SPEED VIA P1
MOVE LINEAR WITH V=PATH_SPEED VIA P2
