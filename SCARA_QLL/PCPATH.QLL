;;CONTROL = rho4
;;INT = LINEAR
;;KINEMATICS: (1=ROBI1)
;;ROBI1.JC_NAMES = A1,A2,A3,A4
;;ROBI1.WC_NAMES = K1,K2,K3,K4

PROGRAM PCPATH

EXTERNAL PERMPROG: MOVE_STATE
EXTERNAL PERMPROG: MOVE_ERROR
EXTERNAL PERMPROG: PATH_COUNT
EXTERNAL PERMPROG: PATH_SPEED
EXTERNAL PERMPROG: PATHDATA

POINT: P1
POINT: P2
POINT: P3
POINT: P4
POINT: P5
POINT: P6
POINT: P7
POINT: P8
POINT: P9
POINT: P10
POINT: P11
POINT: P12
POINT: P13
POINT: P14
POINT: P15
POINT: P16

BEGIN

; ============================================================
; PCPATH V1 - az 16 absolutnich XYZR bodu
; Data jsou nahrana do PUBLIC PATHDATA pred START PCPATH.
; Uvnitr PROGR_SLOPE neni READ/WRITE/IF/WAIT.
; ============================================================

P1.K1=PATHDATA[1]
P1.K2=PATHDATA[2]
P1.K3=PATHDATA[3]
P1.K4=PATHDATA[4]

P2.K1=PATHDATA[5]
P2.K2=PATHDATA[6]
P2.K3=PATHDATA[7]
P2.K4=PATHDATA[8]

P3.K1=PATHDATA[9]
P3.K2=PATHDATA[10]
